{
  "name": "@zuulpass/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZuulPass Node CLI client (command: zuulp)",
  "bin": {
    "zuulp": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@zuulpass/api-types": "workspace:*",
    "@zuulpass/core": "workspace:*",
    "commander": "^15.0.0"
  }
}
