{
  "name": "zuulpass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-knowledge password manager: Cloudflare Worker backend + Node CLI",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
